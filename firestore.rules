rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only allow operations on link99_ collections to avoid affecting existing apps
    match /link99_links/{document} {
      allow read: if resource.data.published == true || request.auth.uid == 'BQwpimLOkbQe9wAdyC6vf0a94XY2';
      allow write: if request.auth.uid == 'BQwpimLOkbQe9wAdyC6vf0a94XY2';
    }
    
    match /link99_categories/{document} {
      allow read: if true;
      allow write: if request.auth.uid == 'BQwpimLOkbQe9wAdyC6vf0a94XY2';
    }
  }
}
